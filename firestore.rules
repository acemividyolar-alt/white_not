rules_version = '2';
// White Note ekip modu: sadece ekip üyeleri okur ve yazar.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function teamPath(t) { return /databases/$(database)/documents/teams/$(t); }
    function isMember(t) {
      return signedIn() && exists(/databases/$(database)/documents/teams/$(t)/members/$(request.auth.uid));
    }
    function isOwner(t) { return signedIn() && get(teamPath(t)).data.owner == request.auth.uid; }
    function inviteCode(t) { return get(/databases/$(database)/documents/teams/$(t)/secret/invite).data.code; }

    // Kişinin kendi ekip listesi
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /teams/{t} {
      allow read: if isMember(t);
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow update: if isOwner(t) && request.resource.data.owner == resource.data.owner
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;

      // Üyeler: sahip kendini ekler; diğerleri davet koduyla katılır
      match /members/{uid} {
        allow read: if isMember(t);
        allow create: if signedIn() && uid == request.auth.uid && (
          (get(teamPath(t)).data.owner == request.auth.uid && request.resource.data.role == 'owner')
          || (request.resource.data.role == 'member' && request.resource.data.code == inviteCode(t)));
        allow update: if signedIn() && uid == request.auth.uid && request.resource.data.role == resource.data.role;
        allow delete: if isOwner(t) || (signedIn() && uid == request.auth.uid);
      }

      // Davet kodu: üyeler görür (bağlantıyı paylaşmak için), sadece sahip değiştirir
      match /secret/{doc} {
        allow read: if isMember(t);
        allow write: if isOwner(t);
      }

      // Notlar, görevler, panolar, şemalar, akış şemaları
      match /records/{rid} {
        allow read: if isMember(t);
        allow create, update: if isMember(t)
          && request.resource.data.keys().hasOnly(['k', 'd', 't', 'u'])
          && request.resource.data.k is string && request.resource.data.d is string
          && request.resource.data.u == request.auth.uid && request.resource.data.t == request.time;
        allow delete: if isMember(t);
      }

      // Kim çevrimiçi
      match /presence/{uid} {
        allow read: if isMember(t);
        allow write: if isMember(t) && uid == request.auth.uid;
      }
    }
  }
}
